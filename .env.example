# Required: Anthropic API key for digest generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required: GitHub fine-grained PAT for affiliation-fix issue workflow
# Permissions needed: Issues (write), Contents (write), Pull requests (write)
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO=owner/repo-name

# Optional: Shared secret to protect the /api/flag-affiliation endpoint
# Set the same value in Vercel env vars as NEXT_PUBLIC_FLAG_SECRET
# NEXT_PUBLIC_FLAG_SECRET=your_random_secret_here

# Optional: pod2txt API key for podcast transcripts (https://pod2txt.com)
POD2TXT_API_KEY=your_pod2txt_api_key_here
